{
  "name": "kirby-copilot",
  "type": "module",
  "version": "3.15.1",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "mprocs",
    "build": "kirbyup src/panel/index.ts",
    "build:assets": "rm -rf assets && tsdown --config src/assets/tsdown.config.ts",
    "build:playground": "PLAYGROUND=true pnpm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"src/panel/**\" \"tests/panel/**\" \"tests/fixtures/**\" --write",
    "test": "vitest",
    "test:types": "tsc --noEmit",
    "release": "pnpm run build && pnpm run build:assets && bumpp --all --execute \"npx zx scripts/pre-release.mjs\" && zx scripts/post-release.mjs"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.82",
    "@ai-sdk/google": "^4.0.99",
    "@ai-sdk/mistral": "^4.0.66",
    "@ai-sdk/openai": "^4.0.96",
    "@ai-sdk/provider": "^4.0.29",
    "@ai-sdk/provider-utils": "^5.0.62",
    "@antfu/eslint-config": "^9.5.1",
    "@kirby-tools/licensing": "^0.9.0",
    "@types/node": "^26.6.5",
    "@unocss/eslint-plugin": "^66.11.0",
    "ai": "^7.0.143",
    "bumpp": "^12.3.0",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "jiti": "^2.7.0",
    "kirby-types": "^1.8.2",
    "kirbyup": "^3.5.0",
    "kirbyuse": "^1.4.2",
    "mprocs": "^0.9.6",
    "ohash": "^2.0.12",
    "prettier": "^3.9.10",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.6",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "unocss": "^66.11.0",
    "utilful": "^3.5.1",
    "vite": "^6.4.3",
    "vitest": "^5.0.5",
    "vue": "^2.7.16",
    "zod": "^4.6.7",
    "zx": "^8.8.5"
  }
}

{
  "name": "johannschopplich/kirby-copilot",
  "description": "Generate with AI in the Panel, or connect your agents over MCP",
  "type": "kirby-plugin",
  "version": "3.15.1",
  "keywords": [
    "kirby",
    "kirby-cms",
    "kirby-plugin",
    "ai",
    "ai-agents",
    "llm",
    "mcp"
  ],
  "license": "proprietary",
  "homepage": "https://kirby.tools/copilot",
  "authors": [
    {
      "name": "Johann Schopplich",
      "email": "hello@johannschopplich.com",
      "homepage": "https://johannschopplich.com"
    }
  ],
  "require": {
    "php": ">=8.3",
    "getkirby/composer-installer": "^1",
    "johannschopplich/kirby-tools-licensing": "^1.0.0-beta.1",
    "johannschopplich/kirby-tools-utils": "^1.0.0-beta.1",
    "openai-php/client": "^0.19",
    "anthropic-ai/sdk": "^0.17",
    "guzzlehttp/guzzle": "^7.10"
  },
  "require-dev": {
    "getkirby/cms": "^6.0@beta",
    "phpunit/phpunit": "^12",
    "vlucas/phpdotenv": "^5"
  },
  "conflict": {
    "getkirby/cms": "<6"
  },
  "scripts": {
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "@php -S localhost:8000 -t playground/public vendor/getkirby/cms/router.php"
    ],
    "csfix": "@php tools/phpcs/vendor/bin/php-cs-fixer fix",
    "test": "phpunit",
    "dist": "composer install --no-dev"
  },
  "autoload": {
    "psr-4": {
      "JohannSchopplich\\": "src/classes/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "getkirby/composer-installer": true,
      "php-http/discovery": true
    }
  },
  "extra": {
    "kirby-cms-path": false,
    "kirby": {
      "compatible": "^6.0"
    }
  }
}
